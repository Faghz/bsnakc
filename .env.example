# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_ENV=development

# Log Level: debug, info, warn, error, dpanic, panic, fatal
# If not set, defaults to 'debug' in development and 'info' in production
LOG_LEVEL=debug

# Log Stack Level: debug, info, warn, error (empty = no automatic stack traces)
# Controls at which log level stack traces are automatically captured
# Leave empty to disable automatic stack traces (recommended)
# Use ports.StackTrace() field to explicitly add stack traces when needed
# LOG_STACK_LEVEL=error

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=marshal
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# PASETO Configuration
# Generate key with: openssl rand -hex 32
PASETO_SYMMETRIC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PASETO_ACCESS_TOKEN_DURATION=15m
PASETO_REFRESH_TOKEN_DURATION=7d

# Encryption Configuration - Domain-Specific Keys
# Generate keys with: openssl rand -hex 32
# IMPORTANT: Keep these keys secret and use different keys for each domain

# User domain encryption keys
USER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
USER_HMAC_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# Identity domain encryption keys
IDENTITY_ENCRYPTION_KEY=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
IDENTITY_HMAC_SECRET=0123456789fedcba0123456789fedcba0123456789fedcba0123456789fedcba

# OAuth - Discord
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URL=http://localhost:8080/api/v1/auth/callback/discord

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# OpenTelemetry Configuration
# Enable/disable OpenTelemetry (default: false)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=marshal
OTEL_SERVICE_VERSION=1.0.0
# Environment: development, staging, production
OTEL_ENVIRONMENT=development
# Exporter type: otlp (production), console (development)
OTEL_EXPORTER_TYPE=console
# OTLP gRPC endpoint (e.g., Jaeger, Tempo, or OTel Collector)
OTEL_OTLP_ENDPOINT=localhost:4317
# Use insecure connection (true for local dev, false for production)
OTEL_OTLP_INSECURE=true
# Sampling rate: 0.0 to 1.0 (1.0 = 100% sampling, 0.1 = 10% sampling)
OTEL_SAMPLE_RATE=1.0

# OpenTelemetry Logs Configuration (optional)
# Export application logs to SigNoz/OTel collector alongside traces
# Logs can be enabled independently from traces
OTEL_LOGS_ENABLED=false
# Log exporter type: otlp (production), console (development/testing)
OTEL_LOGS_EXPORTER_TYPE=otlp
# Optional: Override endpoint for logs (defaults to OTEL_OTLP_ENDPOINT if not set)
# Useful if you want to send logs to a different collector than traces
# OTEL_LOGS_OTLP_ENDPOINT=localhost:4317
